    {
      "title": "Contrôle automatique",
      "text": "%sh\nok () { printf \"  [ OK ] %s\\n\" \"$1\"; }; ko () { printf \"  [ KO ] %s\\n\" \"$1\"; }\nHADOOP_USER_NAME=eve hdfs dfs -ls /data/referentiel/clients/raffinee > /dev/null 2>&1 && ko \"eve (hors groupe) lit le référentiel !\" || ok \"eve (hors groupe) ne peut pas lire le référentiel\"\nHADOOP_USER_NAME=bob hdfs dfs -ls /data/referentiel/clients/raffinee > /dev/null 2>&1 && ok \"bob (marketing) lit le référentiel grâce à l'ACL\" || ko \"bob ne lit pas le référentiel (étape 2.2)\"\nHADOOP_USER_NAME=crm_admin hdfs dfs -test -e /data/referentiel/clients/.snapshot/avant_maj/brute/web_2026-11.csv && HADOOP_USER_NAME=crm_admin hdfs dfs -test -e /data/referentiel/clients/brute/web_2026-11.csv \\\n  && ok \"fichier supprimé restauré depuis l'instantané avant_maj\" || ko \"instantané et restauration (étape 3)\"\nattendu=$(python3 -c \"import json; print(json.load(open('/opt/data/hdd/attendus.json'))['referentiel']['nb_clients'])\")\nn=$(HADOOP_USER_NAME=crm_admin hdfs dfs -cat /data/referentiel/clients/raffinee/clients/part-* 2>/dev/null | wc -l)\n[ \"$n\" = \"$attendu\" ] && ok \"référentiel Pig : $n clients (attendu $attendu)\" || ko \"référentiel Pig : $n clients (attendu $attendu)\"\nh=$(sed -n '2,11p' /tmp/hdd/tp4/jdbc_hive.txt 2>/dev/null | awk '{print $1,$2}'); i=$(sed -n '2,11p' /tmp/hdd/tp4/jdbc_impala.txt 2>/dev/null | awk '{print $1,$2}')\n[ -n \"$h\" ] && [ \"$h\" = \"$i\" ] && ok \"même table, mêmes résultats depuis Hive et Impala\" || ko \"comparaison Hive / Impala (étape 6.7)\"\necho \"  (graphique : à constater dans Zeppelin, paragraphes 7.x, ou dans Hue)\"",
