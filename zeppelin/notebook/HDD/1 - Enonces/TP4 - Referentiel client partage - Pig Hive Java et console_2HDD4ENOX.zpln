      "jobName": "paragraph_1795824000010_48351682",
      "id": "20261123-090010_048351682",
      "dateCreated": "2026-11-23 09:00:00.000",
      "status": "READY"
    },
    {
      "title": "3.3 Instantané avant modification, puis incident",
      "text": "%sh\nSU=\"env HADOOP_USER_NAME=hadoop\"; CRM=\"env HADOOP_USER_NAME=crm_admin\"\n# TODO (superutilisateur) : autoriser les instantanés sur /data/referentiel/clients (hdfs dfsadmin -allowSnapshot ...)\n$CRM hdfs dfs -deleteSnapshot /data/referentiel/clients avant_maj 2>/dev/null\n# TODO (crm_admin) : créer l'instantané « avant_maj » de /data/referentiel/clients (hdfs dfs -createSnapshot ...)\n$CRM hdfs dfs -ls /data/referentiel/clients/.snapshot\necho \"--- incident : suppression d'un fichier source\"\n$CRM hdfs dfs -rm -skipTrash /data/referentiel/clients/brute/web_2026-11.csv\n$CRM hdfs dfs -ls /data/referentiel/clients/brute",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
