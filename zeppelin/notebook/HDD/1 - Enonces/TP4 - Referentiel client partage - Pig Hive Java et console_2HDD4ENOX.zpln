      "jobName": "paragraph_1795824000019_323983908",
      "id": "20261123-090019_323983908",
      "dateCreated": "2026-11-23 09:00:00.000",
      "status": "READY"
    },
    {
      "title": "5.4 Exécuter le script (MapReduce sur YARN)",
      "text": "%sh\ncd /tmp/hdd/tp4\nCRM=\"env HADOOP_USER_NAME=crm_admin\"\n$CRM hdfs dfs -rm -r -f -skipTrash /data/referentiel/clients/raffinee/clients /data/referentiel/clients/raffinee/stats_villes\n$CRM pig -x mapreduce \\\n    -param BRUTE=/data/referentiel/clients/brute \\\n    -param SORTIE_REF=/data/referentiel/clients/raffinee/clients \\\n    -param SORTIE_STATS=/data/referentiel/clients/raffinee/stats_villes \\\n    -param UDF_JAR=/tmp/hdd/tp4/udfs.jar \\\n    -f /tmp/hdd/tp4/referentiel_clients.pig 2>&1 | tee /tmp/hdd/tp4/pig.log | grep -E 'Success|Failed|Input\\(s\\)|Output\\(s\\)|records|HadoopJobId|ERROR' | head -20\n$CRM hdfs dfs -ls /data/referentiel/clients/raffinee/clients /data/referentiel/clients/raffinee/stats_villes",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
