    {
      "title": "3.2 Le piège du quota d'espace",
      "text": "%sh\n# Piège classique : un quota d'espace se vérifie BLOC par bloc. Pour écrire,\n# HDFS réserve un bloc entier (128 Mo x réplication), même pour un petit fichier.\nSU=\"env HADOOP_USER_NAME=hadoop\"\n$SU hdfs dfs -mkdir -p /data/referentiel/bac_a_sable && $SU hdfs dfs -chmod 777 /data/referentiel/bac_a_sable\n$SU hdfs dfsadmin -setSpaceQuota 50m /data/referentiel/bac_a_sable\necho \"un fichier de 1 Ko\" > /tmp/hdd_petit.txt\nhdfs dfs -put -f /tmp/hdd_petit.txt /data/referentiel/bac_a_sable/ 2>&1 | grep -iE 'quota' | head -2 | cut -c1-200\n$SU hdfs dfs -rm -r -f -skipTrash /data/referentiel/bac_a_sable > /dev/null",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "sh",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sh",
        "fontSize": 9.0,
        "editorHide": false,
        "title": true,
        "results": {},
