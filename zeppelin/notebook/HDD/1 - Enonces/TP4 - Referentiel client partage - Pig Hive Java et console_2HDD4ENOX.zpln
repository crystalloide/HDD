      "dateStarted": "2026-11-23 09:00:00.000",
      "dateFinished": "2026-11-23 09:00:00.000"
    },
    {
      "title": "5.1 UDF NormaliseVille.java",
      "text": "%sh\nmkdir -p /tmp/hdd/tp4/src/fr/orsys/hdd/tp4\ncat > /tmp/hdd/tp4/src/fr/orsys/hdd/tp4/NormaliseVille.java <<'EOF'\npackage fr.orsys.hdd.tp4;\n\nimport java.io.IOException;\nimport java.text.Normalizer;\nimport java.util.Locale;\n\nimport org.apache.pig.EvalFunc;\nimport org.apache.pig.data.Tuple;\n\n/**\n * UDF Pig (Pig appelle Java) : normalise un nom de ville.\n * \"  saint-étienne \" -> \"SAINT-ETIENNE\" ; chaîne vide ou absente -> null.\n *\n * Utilisation dans un script :\n *   REGISTER '/tmp/hdd/tp4/udfs.jar';\n *   DEFINE NormaliseVille fr.orsys.hdd.tp4.NormaliseVille();\n *   b = FOREACH a GENERATE NormaliseVille(ville);\n *\n * Même règle que le mapper de collecte du TP1 et que la version PySpark du TP5.\n */\npublic class NormaliseVille extends EvalFunc<String> {\n\n  @Override\n  public String exec(Tuple in) throws IOException {\n    if (in == null || in.size() == 0 || in.get(0) == null) {\n      return null;\n    }\n    // TODO : à partir de in.get(0).toString() :\n    //   1. retirer les accents : Normalizer.normalize(s, Normalizer.Form.NFD) puis supprimer les \\\\p{M}\n    //   2. retirer les espaces en tête et en fin, réduire les espaces multiples à un seul\n    //   3. passer en majuscules (Locale.ROOT)\n    String v = \"\";\n    return v.isEmpty() ? null : v;\n  }\n}\nEOF\necho \"écrit : /tmp/hdd/tp4/src/fr/orsys/hdd/tp4/NormaliseVille.java\"",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "sh",
          "editOnDblClick": false,
