    {
      "title": "3.1 Quotas d'espace et de noms",
      "text": "%sh\nSU=\"env HADOOP_USER_NAME=hadoop\"\n# TODO (superutilisateur) : quota d'espace de 1 Go sur /data/referentiel/clients (hdfs dfsadmin -setSpaceQuota ...)\n# TODO (superutilisateur) : quota de 10 000 noms (fichiers + répertoires) (hdfs dfsadmin -setQuota ...)\n$SU hdfs dfs -count -q -h -v /data/referentiel/clients",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
