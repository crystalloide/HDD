    {
      "title": "2.3 Vérifier",
      "text": "%sh\nfor u in alice bob eve; do\n  printf \"%-6s : \" $u; HADOOP_USER_NAME=$u hdfs dfs -ls /data/referentiel/clients/brute > /dev/null 2>/tmp/hdd_err && echo \"lecture autorisée\" || grep -o 'Permission denied.*' /tmp/hdd_err | cut -c1-90\ndone\necho \"--- et en écriture ?\"\nHADOOP_USER_NAME=bob hdfs dfs -touchz /data/referentiel/clients/brute/essai_bob 2>&1 | grep -o 'Permission denied.*' | cut -c1-90",
