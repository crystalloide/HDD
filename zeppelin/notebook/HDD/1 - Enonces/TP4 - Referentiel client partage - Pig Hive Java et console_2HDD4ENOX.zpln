    {
      "title": "5.2 Compiler l'UDF (udfs.jar)",
      "text": "%sh\ncd /tmp/hdd/tp4\nPIG_JAR=$(ls $PIG_HOME/pig-*-core-h3.jar $PIG_HOME/pig-*.jar 2>/dev/null | grep -v -- -withouthadoop | head -1)\necho \"Pig : $PIG_JAR\"\nrm -rf classes && mkdir -p classes\n/opt/jdk17/bin/javac --release 17 -encoding UTF-8 -cp \"$PIG_JAR:$(hadoop classpath)\" -d classes src/fr/orsys/hdd/tp4/NormaliseVille.java \\\n  && /opt/jdk17/bin/jar cf udfs.jar -C classes . && echo \"OK : $(ls -l udfs.jar)\"",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
