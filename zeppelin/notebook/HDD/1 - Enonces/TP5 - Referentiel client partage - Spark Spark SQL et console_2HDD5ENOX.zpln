      "title": "4.2 Fichiers, volumes, ACL héritées",
      "text": "%sh\nSU=\"env HADOOP_USER_NAME=hadoop\"\n$SU hdfs dfs -ls /data/referentiel/clients/spark/clients | head -6\n$SU hdfs dfs -du -s -h /data/referentiel/clients/raffinee/clients /data/referentiel/clients/spark/clients 2>/dev/null\necho \"--- ACL héritées par une partition écrite par Spark\"\n$SU hdfs dfs -getfacl \"/data/referentiel/clients/spark/clients/ville=LYON\"",
