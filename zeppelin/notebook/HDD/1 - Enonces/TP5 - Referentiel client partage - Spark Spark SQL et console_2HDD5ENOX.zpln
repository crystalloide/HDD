      "title": "1.2 Quelques lignes anormales",
      "text": "%spark.pyspark\n# Les anomalies, vues par Spark\nz.show(brut.filter(~F.col(\"id\").rlike(r\"^C[0-9]{6}$\") | F.col(\"date_inscription\").isNull()\n                   | (F.trim(F.col(\"ville\")) == \"\") | ~F.col(\"ca\").rlike(r\"^[0-9]+(\\.[0-9]+)?$\")).limit(15))",
