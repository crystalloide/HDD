    {
      "title": "7.1 spark-submit du programme batch",
      "text": "%sh\nhead -40 /opt/tp/tp5-spark/referentiel_spark.py | tail -25\necho \"...\"\nspark-submit --master spark://spark-master:7077 --conf spark.cores.max=2 \\\n    /opt/tp/tp5-spark/referentiel_spark.py hdfs://namenode:8020/data/referentiel/clients/brute hdfs://namenode:8020/data/referentiel/clients/spark/batch 2>&1 \\\n  | grep -E 'SPARK_REFERENTIEL|^\\+|^\\|' | head -12",
      "user": "anonymous",
