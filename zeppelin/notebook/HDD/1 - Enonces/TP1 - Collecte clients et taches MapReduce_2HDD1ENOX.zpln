      "jobName": "paragraph_1795824000030_356866507",
      "id": "20261123-090030_356866507",
      "dateCreated": "2026-11-23 09:00:00.000",
      "status": "FINISHED",
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "HTML",
            "data": "<div class=\"markdown-body\">\n<h3>Pour aller plus loin : le même calcul en une ligne de SQL</h3>\n<p>Une table Hive externe posée sur les fichiers produits par MapReduce rend leur résultat interrogeable en SQL. Et la requête équivalente, sur les données propres, est exécutée par Hive… sous forme de DAG Tez sur YARN.</p>\n</div>"
          }
        ]
      },
      "dateStarted": "2026-11-23 09:00:00.000",
      "dateFinished": "2026-11-23 09:00:00.000"
    },
    {
      "title": "B.1 Tables Hive externes sur les résultats",
      "text": "%hive\nCREATE DATABASE IF NOT EXISTS tp1;\nCREATE EXTERNAL TABLE IF NOT EXISTS tp1.ca_villes (ville STRING, ca_total DOUBLE)\nROW FORMAT DELIMITED FIELDS TERMINATED BY ';' LOCATION '/data/out/ca_villes';\nCREATE EXTERNAL TABLE IF NOT EXISTS tp1.clients_propres (\n  id STRING, nom STRING, ville STRING, ca DOUBLE, segment STRING, canal STRING, date_inscription STRING)\nROW FORMAT DELIMITED FIELDS TERMINATED BY ';' LOCATION '/data/clean/clients'\nTBLPROPERTIES ('comment' = 'contient aussi les rejets-m-* : voir la requête');",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sql",
        "fontSize": 9.0,
        "editorHide": false,
        "title": true,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1795824000031_67906456",
      "id": "20261123-090031_067906456",
      "dateCreated": "2026-11-23 09:00:00.000",
      "status": "READY"
    },
    {
      "title": "B.2 SQL contre MapReduce",
      "text": "%hive\n-- rejets-m-* : 1er champ = motif, ce n'est pas un identifiant client => filtrés\nSELECT p.ville, ROUND(SUM(p.ca), 2) AS ca_sql, MAX(m.ca_total) AS ca_mapreduce\nFROM tp1.clients_propres p JOIN tp1.ca_villes m ON p.ville = m.ville\nWHERE p.id RLIKE '^C[0-9]{6}$'\nGROUP BY p.ville\nORDER BY ca_sql DESC\nLIMIT 10",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sql",
