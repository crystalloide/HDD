      "status": "READY"
    },
    {
      "title": "6. Lire le résultat",
      "text": "%sh\nhdfs dfs -ls /demo/out\necho \"--- les 15 mots les plus fréquents\"\nhdfs dfs -cat /demo/out/part-r-00000 | sort -t$'\\t' -k2,2nr | head -15",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
