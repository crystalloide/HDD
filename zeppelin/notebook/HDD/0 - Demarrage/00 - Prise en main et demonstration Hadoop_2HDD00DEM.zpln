      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1795824000003_820312977",
      "id": "20261123-090003_820312977",
      "dateCreated": "2026-11-23 09:00:00.000",
      "status": "READY"
    },
    {
      "title": "3. YARN : nœuds, files, capacité",
      "text": "%sh\nyarn node -list -showDetails 2>/dev/null | head -20\necho \"--- files du Capacity Scheduler\"\nmapred queue -list 2>/dev/null | grep -E 'Queue Name|Queue State|Scheduling Info' | head -12\necho \"--- métriques du cluster (API REST du ResourceManager)\"\ncurl -s http://resourcemanager:8088/ws/v1/cluster/metrics | python3 -c \"import json,sys; m=json.load(sys.stdin)['clusterMetrics']; print('mémoire YARN :', m['totalMB'], 'Mo | vcores :', m['totalVirtualCores'], '| nœuds actifs :', m['activeNodes'])\"",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "sh",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sh",
