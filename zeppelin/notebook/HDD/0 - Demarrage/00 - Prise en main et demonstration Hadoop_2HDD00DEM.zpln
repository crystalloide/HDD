    {
      "title": "7. Le job dans le JobHistory",
      "text": "%sh\n# Les jobs terminés sont connus du JobHistory Server (http://localhost:19888)\ncurl -s \"http://historyserver:19888/ws/v1/history/mapreduce/jobs\" | python3 -c \"\nimport json, sys, datetime\njobs = (json.load(sys.stdin).get('jobs') or {}).get('job', [])\nfor j in sorted(jobs, key=lambda j: j['startTime'])[-5:]:\n    debut = datetime.datetime.fromtimestamp(j['startTime'] / 1000).strftime('%H:%M:%S')\n    print(f\\\"{j['id']}  {j['name'][:28]:28}  {j['user']:10} {j['queue']:8} {j['state']:10} début {debut}  maps={j['mapsTotal']} reduces={j['reducesTotal']}\\\")\n\"",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "sh",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sh",
