      "jobName": "paragraph_1795824000006_287083877",
      "id": "20261123-090006_287083877",
      "dateCreated": "2026-11-23 09:00:00.000",
      "status": "READY"
    },
    {
      "title": "5. Lancer wordcount sur YARN",
      "text": "%sh\nhdfs dfs -rm -r -f -skipTrash /demo/out\nyarn jar /opt/hadoop/share/hadoop/mapreduce/hadoop-mapreduce-examples-*.jar \\\n     wordcount /demo/in /demo/out 2>&1 | grep -E 'Running job|Submitted application|map [0-9]+% reduce|completed successfully|Map input records|Reduce output records|failed'",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
