      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1795824000002_826718029",
      "id": "20261123-090002_826718029",
      "dateCreated": "2026-11-23 09:00:00.000",
      "status": "READY"
    },
    {
      "title": "2. Capacité HDFS (superutilisateur)",
      "text": "%sh\n# Rapport du cluster : réservé au superutilisateur HDFS (le compte « hadoop »\n# qui fait tourner le NameNode). En authentification simple, HDFS croit la\n# variable HADOOP_USER_NAME : c'est pratique en TP, et c'est exactement\n# pourquoi un cluster de production active Kerberos.\nHADOOP_USER_NAME=hadoop hdfs dfsadmin -report | head -25",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "sh",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sh",
        "fontSize": 9.0,
        "editorHide": false,
        "title": true,
