    {
      "title": "5.3 Pig/Hive et Spark donnent-ils le même référentiel ?",
      "text": "%spark.pyspark\n# Comparaison avec le référentiel Pig/Hive du TP4 (s'il existe)\nif spark.catalog.tableExists(\"referentiel.clients_orc\"):\n    tp4 = spark.table(\"referentiel.clients_orc\").select(\"id\", F.col(\"ca_total\").alias(\"ca_tp4\"))\n    tp5 = spark.table(\"referentiel.clients_spark\").select(\"id\", F.col(\"ca_total\").alias(\"ca_tp5\"))\n    ecarts = tp4.join(tp5, \"id\", \"full_outer\").filter(\"ca_tp4 IS NULL OR ca_tp5 IS NULL OR abs(ca_tp4 - ca_tp5) > 0.01\")\n    print(\"clients TP4 :\", tp4.count(), \"| clients TP5 :\", tp5.count(), \"| écarts :\", ecarts.count())\nelse:\n    print(\"Table referentiel.clients_orc absente : TP4 non réalisé, comparaison ignorée.\")",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
