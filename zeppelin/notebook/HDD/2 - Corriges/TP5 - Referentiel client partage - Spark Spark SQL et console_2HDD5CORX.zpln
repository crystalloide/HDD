      "dateStarted": "2026-11-23 09:00:00.000",
      "dateFinished": "2026-11-23 09:00:00.000"
    },
    {
      "title": "5.1 Les 3 meilleurs clients par ville (fenêtre)",
      "text": "%spark.sql\nSELECT ville, segment, id, nom, ca_total, rang\nFROM (\n  SELECT ville, segment, id, nom, ca_total,\n         ROW_NUMBER() OVER (PARTITION BY ville ORDER BY ca_total DESC) AS rang\n  FROM referentiel.clients_spark\n) t\nWHERE rang <= 3 AND ville IN ('PARIS', 'LYON', 'MARSEILLE')\nORDER BY ville, rang",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "sql",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12.0,
        "editorMode": "ace/mode/sql",
        "fontSize": 9.0,
        "editorHide": false,
        "title": true,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1795824000018_291266148",
      "id": "20261123-090018_291266148",
      "dateCreated": "2026-11-23 09:00:00.000",
      "status": "READY"
    },
    {
      "title": "5.2 Indicateurs par segment",
      "text": "%spark.sql\nSELECT segment,\n       COUNT(*)                                   AS nb_clients,\n       ROUND(AVG(ca_total), 2)                    AS ca_moyen,\n       ROUND(100 * AVG(IF(nb_canaux > 1, 1, 0)), 1) AS pct_multi_canaux\nFROM referentiel.clients_spark\nGROUP BY segment\nORDER BY ca_moyen DESC",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
