      "jobName": "paragraph_1795824000029_16456922",
      "id": "20261123-090029_016456922",
      "dateCreated": "2026-11-23 09:00:00.000",
      "status": "READY"
    },
    {
      "title": "6.2 Table externe Hive sur l'export",
      "text": "%hive\n-- TP3 — Table externe Hive sur l'export du catalogue HBase\nCREATE DATABASE IF NOT EXISTS catalogue;\n\nCREATE EXTERNAL TABLE IF NOT EXISTS catalogue.produits_export (\n  id        STRING,\n  libelle   STRING,\n  categorie STRING,\n  prix      DOUBLE,\n  promo     STRING,\n  quantite  INT,\n  entrepot  STRING\n)\nROW FORMAT DELIMITED FIELDS TERMINATED BY ';'\nSTORED AS TEXTFILE\nLOCATION '/data/catalogue/export'",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
