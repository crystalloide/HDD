      "jobName": "paragraph_1795824000036_956590184",
      "id": "20261123-090036_956590184",
      "dateCreated": "2026-11-23 09:00:00.000",
      "status": "FINISHED",
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "HTML",
            "data": "<div class=\"markdown-body\">\n<h3>Contrôle des critères de réussite</h3>\n</div>"
          }
        ]
      },
      "dateStarted": "2026-11-23 09:00:00.000",
      "dateFinished": "2026-11-23 09:00:00.000"
    },
    {
      "title": "Contrôle automatique",
      "text": "%python\nimport happybase, subprocess\nok = lambda m: print(\"  [ OK ]\", m)\nko = lambda m: print(\"  [ KO ]\", m)\nconn = happybase.Connection(\"hbase-thrift\", 9090, timeout=20000)\nt = conn.table(\"catalogue\")\nversions = t.cells(b\"P0001\", b\"info:prix\", versions=5)\n(ok if len(versions) == 3 else ko)(f\"P0001 : {len(versions)} versions lisibles de info:prix {[v.decode() for v in versions]}\")\npromos = sum(1 for _ in t.scan(columns=[b\"info:promo\"]))\ntotal = sum(1 for _ in t.scan(columns=[b\"info:libelle\"]))\n(ok if 0 < promos < total else ko)(f\"info:promo présente sur {promos} produits sur {total}\")\ncourant = t.row(b\"P0001\", columns=[b\"info:prix\"]).get(b\"info:prix\", b\"\").decode()\n(ok if courant == \"25.90\" else ko)(f\"mise à jour conditionnelle : prix courant de P0001 = {courant} (25.90 attendu, la 2e mise à jour refusée)\")\nconn.close()\nexport = subprocess.run([\"hdfs\", \"dfs\", \"-cat\", \"/data/catalogue/export/catalogue.csv\"], capture_output=True, text=True).stdout\nligne = next((l for l in export.splitlines() if l.startswith(\"P0001;\")), \"\")\n(ok if \";25.90;\" in ligne else ko)(f\"export lu par Hive à jour : {ligne or 'absent (étape 6.1)'}\")",
      "user": "anonymous",
      "dateUpdated": "2026-11-23 09:00:00.000",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
