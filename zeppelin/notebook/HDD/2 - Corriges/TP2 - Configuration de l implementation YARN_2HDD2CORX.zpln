    {
      "title": "B.2 Journaux agrégés d'un job terminé",
      "text": "%sh\napp=$(yarn application -list -appStates FINISHED 2>/dev/null | grep clients-par-ville | tail -1 | awk '{print $1}')\necho \"Journaux agrégés de $app (extrait) :\"\nyarn logs -applicationId \"$app\" 2>/dev/null | grep -E 'LogType|Container:|INFO .*(Starting|Task|completed)' | head -15",
